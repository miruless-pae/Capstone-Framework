# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (cocok dengan docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_DATABASE=vibr

# JWT - ganti dengan string acak panjang (min. 32 karakter)
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# Basis URL publik object storage. URL media = STORAGE_BASE_URL + media_assets.storage_key
STORAGE_BASE_URL=http://localhost:3000/files

# Scheduler: mem-publish post terjadwal yang sudah jatuh tempo
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=30000
SCHEDULER_BATCH_SIZE=20
